{
  "name": "countrycitystatejson-postal-world",
  "version": "26.08.1601",
  "description": "Worldwide postal → city lookup bridged to countrycitystatejson (GeoNames).",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-postal-shared.js world && npm run build:cjs && npm run build:esm && npm run copy:data && npm run fix:modules",
    "build:cjs": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.cjs.json",
    "build:esm": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.esm.json",
    "copy:data": "node ../../scripts/copy-postal-data.js world",
    "fix:modules": "node ../../scripts/fix-postal-modules.js world",
    "prepublishOnly": "npm run build",
    "test": "jest --config ../../jest.postal.config.js --selectProjects postal-world"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khkwan0/countryCityStateJson.git",
    "directory": "packages/postal-world"
  },
  "keywords": [
    "postal",
    "zip",
    "geonames",
    "countrycitystatejson"
  ],
  "author": "khkwan0@github.com",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
