{
  "name": "countrycitystatejson",
  "version": "26.04.0501",
  "description": "A JSON Object containing Countries and their associated States/Provinces and cities.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./server": {
      "types": "./dist/cjs/server.d.ts",
      "import": "./dist/esm/server.js",
      "require": "./dist/cjs/server.js"
    },
    "./client": {
      "types": "./dist/cjs/client.d.ts",
      "import": "./dist/esm/client.js",
      "require": "./dist/cjs/client.js"
    },
    "./countries": {
      "types": "./dist/cjs/countries.d.ts",
      "import": "./dist/esm/countries.js",
      "require": "./dist/cjs/countries.js"
    }
  },
  "files": [
    "dist/",
    "index.js",
    "README.md",
    "LICENSE*"
  ],
  "scripts": {
    "test": "npm run split:client && jest",
    "test:watch": "npm run split:client && jest --watch",
    "compile": "node scripts/compile-data.js",
    "split:client": "node scripts/split-client-data.js",
    "copy:data": "node scripts/copy-data.js",
    "build": "npm run split:client && npm run build:cjs && npm run build:esm && npm run copy:data",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khkwan0/countryCityStateJson.git"
  },
  "keywords": [
    "country",
    "city",
    "state",
    "json"
  ],
  "author": "khkwan0@github.com",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/khkwan0/countryCityStateJson/issues"
  },
  "homepage": "https://github.com/khkwan0/countryCityStateJson#readme",
  "dependencies": {
    "trie-search": "^2.2.0"
  },
  "reveal": true,
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
